# Copie para .env (o .env não vai para o Git).
# Os nomes das variáveis vêm do backend anterior (Django) e foram mantidos para não mudar o Render.
# O banco é o mesmo do flyway.toml.
DB_NAME=mkpause
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Ou uma URL só (Render/Neon): DATABASE_URL=postgresql://usuario:senha@host/banco?sslmode=require

# Assina sessões, códigos e links de convite. Em produção, use uma chave longa e aleatória.
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=1

# Convites: endereço do site que o responsável abrirá (HTTPS em produção).
PUBLIC_BASE_URL=http://localhost:5173

# Padrão local: grava as mensagens em backend/.emails/, sem entrega pela internet.
EMAIL_BACKEND=filebased
EMAIL_ENVIO_AUTOMATICO=0
DEFAULT_FROM_EMAIL=MKpause <nao-responda@mkpause.local>

# Para envio real, troque EMAIL_BACKEND por smtp e configure o provedor:
# EMAIL_BACKEND=smtp
# EMAIL_HOST=smtp.seu-provedor.example
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# EMAIL_USE_SSL=0
# EMAIL_ENVIO_AUTOMATICO=1

# Senha das contas de demonstração (php artisan mkpause:criar-demo).
DEMO_SENHA=

# Laravel
CACHE_STORE=file
SESSION_DRIVER=cookie
LOG_CHANNEL=single
