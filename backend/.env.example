# Copie para .env (o .env não vai para o Git).
# O banco é o mesmo do flyway.toml.
DB_NAME=mkpause
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Convites: endereço do site que o responsável abrirá (HTTPS em produção).
PUBLIC_BASE_URL=http://localhost:5173

# Padrão local: grava mensagens em backend/.emails/, sem entrega pela internet.
EMAIL_BACKEND=django.core.mail.backends.filebased.EmailBackend
EMAIL_ENVIO_AUTOMATICO=0
DEFAULT_FROM_EMAIL=MKpause <nao-responda@mkpause.local>

# Para envio real, configure o SMTP do provedor e troque EMAIL_BACKEND por:
# django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.seu-provedor.example
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# EMAIL_USE_SSL=0
# EMAIL_ENVIO_AUTOMATICO=1
